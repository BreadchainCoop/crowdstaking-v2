NEXT_PUBLIC_QUIKNODE_API_KEY=
NEXT_PUBLIC_ALCHEMY_MAINNET_API_KEY=
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_SUBGRAPH_API_KEY=
# Mt Pelerin partner activation key (developers.mtpelerin.com). Use the docs' local test key when developing.
NEXT_PUBLIC_MTPELERIN_ACTIVATION_KEY=
# Monerium (euro IBAN / EURe on Gnosis). Leave CLIENT_ID empty to hide the
# "Monerium euro account" card on My Account. Register an OAuth app at
# https://sandbox.monerium.dev (Developers → Create application → OAuth) and
# set its redirect URI to {origin}/api/monerium/callback
NEXT_PUBLIC_MONERIUM_CLIENT_ID=
NEXT_PUBLIC_MONERIUM_ENV=sandbox
# Optional server-side override of the OAuth redirect URI (defaults to {origin}/api/monerium/callback)
# MONERIUM_REDIRECT_URI=
# synpress
PRIVATE_KEY=
NEXT_PUBLIC_TEST_CONNECTOR=true

# features
FEATURE_GOVERNANCE=true
FEATURE_BREAD_COUNTER=true
FEATURE_RECAST_VOTE=true
FEATURE_LP_VAULTS=true
FEATURE_BOOSTERS=true
FEATURE_VOTING_HISTORY=true